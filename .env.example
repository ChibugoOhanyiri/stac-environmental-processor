# Metadata discovery needs no secrets.
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# Authenticate to processing interactively; never paste tokens here.
# OPENEO_BACKEND_URL=<verify provider URL before configuring>

# Google Earth Engine (M2). Not a secret, but an account detail: keep the real value in .env (git-ignored).
# Find it in the Code Editor (top right) or https://console.cloud.google.com
GEE_PROJECT=your-cloud-project-id
# Login: run once  .venv/bin/python -c "import ee; ee.Authenticate(auth_mode='localhost')"
# The permission slip (credentials) is saved in ~/.config/earthengine/ (Windows: %USERPROFILE%\.config\earthengine\), never in this repo.
